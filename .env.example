PORT=3000
NODE_ENV=development

# Hosted Postgres (Render/Neon/Railway): a single connection string that takes
# precedence over the discrete DB_* vars below when set.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=mediumclone
DB_SSL=false

# --- Schema management ---
# Schema is migration-driven. Leave TYPEORM_SYNC unset/false: migrations own the
# DDL (see `npm run migration:run`). Set to true ONLY for throwaway local DBs
# where you want TypeORM to auto-create tables from the entities.
TYPEORM_SYNC=false
# When true, pending migrations run automatically on app boot. Leave false to
# run them explicitly from a deploy pipeline (`npm run migration:run`).
MIGRATIONS_RUN=false

JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Redis for caching and shared rate-limit counters. When unset (or
# unreachable) the app degrades gracefully: tag reads hit Postgres and rate
# limits are counted in process memory.
# REDIS_URL=redis://localhost:6379

# Optional: on boot, grant the "admin" role to this existing user so the first
# administrator can exist on a fresh database. Leave empty to disable.
RBAC_BOOTSTRAP_ADMIN_EMAIL=

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
